# Copy to terraform.tfvars (ignored by Git). Replace empty values with your AWS configuration.
aws_region = ""
github_repo = "JaqzO8/ProyectoClimaTEC"
github_environment = "development"
github_oidc_provider_arn = ""
weather_api_mode = "free"
# For commercial mode supply the ARN of a Secrets Manager plaintext secret, never its value.
weather_secret_arn = ""
# First provision with zero tasks, publish images via Actions, then set counts to 1.
desired_count_backend = 0
desired_count_frontend = 0
